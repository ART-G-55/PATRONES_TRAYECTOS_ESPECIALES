@model List<Trayectos_Especiales.Models.Trayecto>

@{
    ViewData["Title"] = "Listado de Trayectos Especiales";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<table class="table table-hover table-bordered shadow-sm">
    <thead class="table-light">
        <tr>
            <th>Fecha Solicitud</th>
            <th>Usuario</th>
            <th>Origen</th>
            <th>Destino</th>
            <th>Fecha Servicio</th>
            <th>Hora Servicio</th>
            <th>Estado</th>
            <th class="text-center">Acción</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var trayecto in Model)
        {
            <tr>
                <td>@trayecto.FechaSolicitud.ToString("MM/dd/yyyy")</td>
                <td>@trayecto.NombreUsuario</td>
                <td>@trayecto.NombreOrigen</td>
                <td>@trayecto.NombreDestino</td>
                <td>@trayecto.FechaServicio.ToString("MM/dd/yyyy")</td>
                <td>@trayecto.HoraServicio</td>
                <td>
                    <span class="badge bg-@(trayecto.Estado == "PENDIENTE" ? "warning text-dark" : "success")">
                        @trayecto.Estado
                    </span>
                </td>
                <td class="text-center">
                    @if (trayecto.Estado == "PENDIENTE")
                    {
                        <form asp-action="ConfirmarEstado" method="post" onsubmit="return confirm('¿Desea cambiar el estado a POR APROBAR?');" style="display:inline;">
                            <input type="hidden" name="idTrayecto" value="@trayecto.Id" />
                            <input type="hidden" name="confirmar" value="true" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">Confirmar</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
