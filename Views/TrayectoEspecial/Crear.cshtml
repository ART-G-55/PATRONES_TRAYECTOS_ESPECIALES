@model Trayectos_Especiales.Models.Trayecto

@{
    ViewData["Title"] = "Crear Trayecto Especial";
    var usuarios = ViewBag.Usuarios as List<SelectListItem>;
    var lugares = ViewBag.Lugares as List<SelectListItem>;
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Crear" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="FechaSolicitud"></label>
        <input asp-for="FechaSolicitud" class="form-control" type="date" />
        <span asp-validation-for="FechaSolicitud" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="UsuarioId"></label>
        <select asp-for="UsuarioId" class="form-control" asp-items="usuarios">
            <option value="">-- Seleccione un usuario --</option>
        </select>
        <span asp-validation-for="UsuarioId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="OrigenId"></label>
        <select asp-for="OrigenId" class="form-control" asp-items="lugares">
            <option value="">-- Seleccione origen --</option>
        </select>
        <span asp-validation-for="OrigenId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DestinoId"></label>
        <select asp-for="DestinoId" class="form-control" asp-items="lugares">
            <option value="">-- Seleccione destino --</option>
        </select>
        <span asp-validation-for="DestinoId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="FechaServicio"></label>
        <input asp-for="FechaServicio" class="form-control" type="date" />
        <span asp-validation-for="FechaServicio" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="HoraServicio"></label>
        <input asp-for="HoraServicio" class="form-control" type="time" />
        <span asp-validation-for="HoraServicio" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
