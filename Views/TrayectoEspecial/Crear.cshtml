@model Trayectos_Especiales.Models.Trayecto
@Html.ValidationSummary(true, "", new { @class = "text-danger" })


@{
    ViewData["Title"] = "Nuevo Trayecto Especial";
    var usuarios = ViewBag.Usuarios as List<Trayectos_Especiales.Models.Usuario>;
    var lugares = ViewBag.Lugares as List<Trayectos_Especiales.Models.OrigenDestino>;
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Crear" method="post">
    <div class="form-group">
        <label for="FechaSolicitud">Fecha de Solicitud</label>
        <input asp-for="FechaSolicitud" class="form-control" type="date" required />
    </div>

    <div class="form-group">
        <label for="UsuarioId">Nombre del Usuario</label>
        <select asp-for="UsuarioId" class="form-control" required>
            <option value="">Seleccione un usuario</option>
            @foreach (var usuario in usuarios)
            {
                <option value="@usuario.Id">@usuario.Nombre</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label for="OrigenId">Lugar de Origen</label>
        <select asp-for="OrigenId" class="form-control" required>
            <option value="">Seleccione un origen</option>
            @foreach (var lugar in lugares)
            {
                <option value="@lugar.Id">@lugar.Lugar</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label for="DestinoId">Lugar de Destino</label>
        <select asp-for="DestinoId" class="form-control" required>
            <option value="">Seleccione un destino</option>
            @foreach (var lugar in lugares)
            {
                <option value="@lugar.Id">@lugar.Lugar</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label for="FechaServicio">Fecha del Servicio</label>
        <input asp-for="FechaServicio" class="form-control" type="date" required min="@DateTime.Now.ToString("yyyy-MM-dd")" />
    </div>

    <div class="form-group">
        <label for="HoraServicio">Hora del Servicio</label>
        <input asp-for="HoraServicio" class="form-control" type="time" required />
    </div>

    <button type="submit" class="btn btn-primary mt-3">Guardar Trayecto</button>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mt-3">
        @ViewBag.Error
    </div>
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success mt-3">
        @TempData["Mensaje"]
    </div>
}
